# The labdex agent: one outgoing WebSocket link to the hub, signed jobs from a fixed list.
# Installed by install.sh; a root agent gets a drop-in (root.conf) that sets User=root.
[Unit]
Description=labdex agent
Documentation=https://labdex-app.github.io/labdex/guide/agent/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=labdex-agent
Group=labdex-agent
ExecStart=/usr/bin/python3 -I /opt/labdex-agent/labdex-agent.pyz run
Restart=on-failure
RestartSec=10
# 3: the hub refused the agent (revoked, or root not allowed): stay stopped until someone looks
RestartPreventExitStatus=3
StateDirectory=labdex-agent
StateDirectoryMode=0700
ConfigurationDirectory=labdex-agent

# Hardening. The agent's narrow sudo rules (labdex-agent sudoers) are how it reads ports and
# containers and starts write jobs, and sudo can't work under NoNewPrivileges. systemd switches
# that on by itself for a service with a user of its own and any of PrivateDevices,
# ProtectKernel*, ProtectClock, ProtectHostname, RestrictNamespaces, RestrictRealtime,
# RestrictAddressFamilies, LockPersonality, MemoryDenyWriteExecute or SystemCallArchitectures, so
# those stay off (checked on Debian 12 with systemd 252). What stays on:
ProtectSystem=strict
ReadWritePaths=/var/lib/labdex-agent
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
# what sudo needs to become root, and what ss needs to see which process owns a socket; nothing
# else, even as root. Write jobs run through systemd-run, started by systemd outside this sandbox.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
